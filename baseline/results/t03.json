  {
    "id": "T2",
    "question": "Can an inline extension gate tool calls (block dangerous bash) without any UI?",
    "verdict": "works",
    "findings": [
      {
        "label": "gate saw",
        "value": [
          {
            "tool": "bash",
            "input": {
              "command": "rm -rf precious.txt"
            },
            "hasUI": false
          },
          {
            "tool": "bash",
            "input": {
              "command": "echo harmless"
            },
            "hasUI": false
          }
        ]
      },
      {
        "label": "tool results returned to model",
        "value": [
          "blocked by policy: destructive command",
          "harmless\n"
        ]
      },
      {
        "label": "file survived",
        "value": true
      }
    ],
    "ms": 10
  },
  {
