#!/bin/sh
# For a checkout: bin/pine works without installing anything. Resolves symlinks so that a link in
# ~/bin works too. (An installed package starts bin/pine.js directly.)
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in /*) SELF="$LINK" ;; *) SELF="$(dirname "$SELF")/$LINK" ;; esac
done
command -v node >/dev/null 2>&1 || { echo "pine needs Node 24 or newer: https://nodejs.org" >&2; exit 1; }
exec node "$(cd "$(dirname "$SELF")" && pwd)/pine.js" "$@"
