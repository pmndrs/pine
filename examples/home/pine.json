{
  "main": "main",
  "defaults": {
    "model": "dev/claude-haiku",
    "thinking": "off"
  },
  "limits": {
    "maxConcurrentRuns": 2
  },
  "http": {
    "host": "127.0.0.1",
    "port": 7463,
    "hooks": {}
  },
  "mcp": {
    "web": {
      "pine": "web",
      "description": "Search the web and read pages",
      "options": { "braveApiKey": "${BRAVE_API_KEY:-}" }
    },
    "browser": {
      "pine": "browser",
      "description": "A real browser for pages that need JavaScript, clicks or forms",
      "options": { "headed": false }
    }
  },
  "sources": {},
  "routes": [],
  "schedules": []
}
